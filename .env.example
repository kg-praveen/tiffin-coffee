# Kite Connect Personal (free). Create the app at developers.kite.trade; redirect URL http://127.0.0.1:5000/kite
# Used READ-ONLY by tools/kite.py (holdings, positions) for the ZERODHA_P account.
KITE_API_KEY=
KITE_API_SECRET=
# Never store the daily access token here. `python -m usecases.sync_holdings kite --request-token`
# obtains it per session and caches it only in the git-ignored .kite_access.token (expires after the IST day).
PATTAZ_DB=db/pattaz.db
